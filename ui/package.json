{
  "name": "@crawlertoll/wp-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CrawlerToll WordPress admin UI — React 19 + Tailwind, built with Vite into free-app + pro-app bundles.",
  "scripts": {
    "build:free": "CT_APP=free vite build",
    "build:pro": "CT_APP=pro vite build",
    "build:unlock": "CT_APP=unlock vite build",
    "build": "npm run build:free && npm run build:pro && npm run build:unlock",
    "dev": "vite",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dompurify": "^3.4.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
